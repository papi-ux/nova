 #define VIDEO_FORMAT_PYROWAVE_444    0x20000 // PyroWave 4:4:4 8-bit
+#define VIDEO_FORMAT_PYROWAVE_10BIT  0x40000 // PyroWave 4:2:0 10-bit HDR10
+#define VIDEO_FORMAT_PYROWAVE_444_10BIT 0x80000 // PyroWave 4:4:4 10-bit HDR10
 
 // What the host has to say before this client will accept the codec from it.
