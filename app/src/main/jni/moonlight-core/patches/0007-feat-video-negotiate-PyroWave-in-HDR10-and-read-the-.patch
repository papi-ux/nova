 src/Limelight.h      |  17 ++++-
 src/PyroWaveSdp.h    | 146 +++++++++++++++++++++++++++++++++++++++++++
 src/RtspConnection.c | 115 ++++++++++++----------------------
 3 files changed, 200 insertions(+), 78 deletions(-)
 create mode 100644 src/PyroWaveSdp.h

