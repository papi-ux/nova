diff --git a/src/PyroWaveSdp.h b/src/PyroWaveSdp.h
new file mode 100644
index 0000000..2a5dd0e
--- /dev/null
+++ b/src/PyroWaveSdp.h
@@ -0,0 +1,146 @@
+// The SDP text this client reads to decide whether a host is offering PyroWave, and on what terms.
+//
+// Its own header for one reason: it is the only place in this client where a protocol decision is made
+// by parsing text, and text parsing is where the mistakes are. As a header it can be included by a
+// harness and tested against malformed, truncated and adversarial payloads without standing up an RTSP
+// connection. tools/test_pyrowave_sdp.py is that harness.
+//
+// static inline rather than a translation unit of its own, so the patch series that carries this stays
+// a diff against upstream rather than a build system change.
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <string.h>
+
+// Whether a space separated list of tokens holds this one as a whole element.
+//
+// Whole element, not substring: the token this client knows is a prefix of every longer one that
+// begins the same way, so a substring search lets a "-v1" client accept a "-v10" host.
+static inline bool sdpListOffersToken(const char* value, const char* end, const char* token) {
+    size_t tokenLength = strlen(token);
+
+    while (value < end) {
+        const char* elementEnd;
+
+        while (value < end && (*value == ' ' || *value == '\t')) {
+            value++;
+        }
+        elementEnd = value;
+        while (elementEnd < end && *elementEnd != ' ' && *elementEnd != '\t') {
+            elementEnd++;
+        }
+
+        if ((size_t)(elementEnd - value) == tokenLength && memcmp(value, token, tokenLength) == 0) {
+            return true;
+        }
+        value = elementEnd;
+    }
+
+    return false;
+}
+
+// Counts an fmtp line for payload 99 and says whether the tokens it offers include the one asked for.
+//
+// A list rather than one value, because a host that can carry more than one colourimetry offers one
+// token for each and a client takes the one it implements. Matching the whole value, which is what
+// this used to do, would make a host offering two tokens unusable by a client that knows one of them.
+static inline void countPyroWaveProfileLine(const char* line, const char* end, const char* token,
+                                     int* matches, int* mismatches) {
+    static const char name[] = "a=fmtp:99";
+    size_t nameLength = sizeof(name) - 1;
+    const char* value;
+
+    if ((size_t)(end - line) <= nameLength || memcmp(line, name, nameLength) != 0) {
+        return;
+    }
+
+    // The separator is not optional, for the reason countSdpAttribute gives.
+    value = line + nameLength;
+    if (*value != ' ' && *value != '\t') {
+        return;
+    }
+
+    while (value < end && (*value == ' ' || *value == '\t')) {
+        value++;
+    }
+    while (end > value && (end[-1] == ' ' || end[-1] == '\t')) {
+        end--;
+    }
+
+    if (sdpListOffersToken(value, end, token)) {
+        (*matches)++;
+    }
+    else {
+        (*mismatches)++;
+    }
+}
+
+// Counts an SDP attribute line whose name matches, and says whether its value was the expected one.
+static inline void countSdpAttribute(const char* line, const char* end, const char* name,
+                              const char* expected, int* matches, int* mismatches) {
+    size_t nameLength = strlen(name);
+    size_t expectedLength = strlen(expected);
+    const char* value;
+
+    if ((size_t)(end - line) <= nameLength || memcmp(line, name, nameLength) != 0) {
+        return;
+    }
+
+    // The separator is not optional. Without checking it, "a=fmtp:990" reads as a line about
+    // payload 99, and so does every longer payload number starting with those digits.
+    value = line + nameLength;
+    if (*value != ' ' && *value != '\t') {
+        return;
+    }
+
+    while (value < end && (*value == ' ' || *value == '\t')) {
+        value++;
+    }
+    while (end > value && (end[-1] == ' ' || end[-1] == '\t')) {
+        end--;
+    }
+
+    if ((size_t)(end - value) == expectedLength && memcmp(value, expected, expectedLength) == 0) {
+        (*matches)++;
+    }
+    else if (mismatches != NULL) {
+        (*mismatches)++;
+    }
+}
+
+// Whether this SDP offers exactly the PyroWave profile this client implements, for payload 99.
+//
+// Deliberately not a substring search over the payload. The token this client knows is a prefix of
+// every longer one that begins the same way, so a "-v1" client accepts a "-v10" host; and a token
+// that turned up inside some unrelated attribute would pass just as well. Either way the client goes
+// on to decode a profile it does not implement, which is a picture that is merely wrong.
+//
+// So the payload has to carry one rtpmap for 99 naming the codec, and one fmtp for 99 whose whole
+// value is the token, and nothing else claiming payload 99. A second mapping saying something else
+// is a refusal and not a choice: a host that offers two codecs or two profiles for one payload type
+// has not said which of them it will send, and picking one would be a guess.
+static inline bool sdpOffersPyroWaveProfile(const char* payload, const char* token) {
+    int codecLines = 0;
+    int otherCodecLines = 0;
+    int profileLines = 0;
+    int otherProfileLines = 0;
+    const char* line = payload;
+
+    while (*line != 0) {
+        const char* end = line;
+        while (*end != 0 && *end != '\r' && *end != '\n') {
+            end++;
+        }
+
+        countSdpAttribute(line, end, "a=rtpmap:99", "PYROWAVE/90000", &codecLines, &otherCodecLines);
+        countPyroWaveProfileLine(line, end, token, &profileLines, &otherProfileLines);
+
+        line = end;
+        while (*line == '\r' || *line == '\n') {
+            line++;
+        }
+    }
+
+    return codecLines == 1 && otherCodecLines == 0 && profileLines == 1 && otherProfileLines == 0;
+}
