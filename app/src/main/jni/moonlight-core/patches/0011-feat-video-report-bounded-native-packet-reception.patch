@@ -0,0 +1,159 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+// Nova/Polaris private, observation-only packet reception report (version 1).
+//
+// The client counts and samples only original RTP video packets that the RTP queue accepted (after
+// AES-GCM succeeded, when video encryption was already negotiated), and sends at most one bounded
+// report per existing periodic control tick over the authenticated encrypted control channel. It is
+// not a packet census, a loss denominator, a capacity or one-way-delay measurement, or a health
+// signal, and nothing in this library acts on it. The full wire contract lives in Nova's
+// docs/native-packet-reception-feedback.md.
+
+// Client-to-host control message type, sent inside the existing encrypted control v2 framing.
+// A private matched Polaris/Nova allocation, not an upstream registry reservation.
+#define PACKET_RECEPTION_PTYPE 0x7F10
+#define PACKET_RECEPTION_VERSION 1
+
+// Host DESCRIBE offer and client ANNOUNCE echo. Both carry exactly the token "1".
+#define PACKET_RECEPTION_HOST_ATTRIBUTE "x-ss-video.packetReceptionFeedbackVersion"
+#define PACKET_RECEPTION_CLIENT_ATTRIBUTE "x-ml-video.packetReceptionFeedbackVersion"
+
+#define PACKET_RECEPTION_HEADER_BYTES 52
+#define PACKET_RECEPTION_SAMPLE_BYTES 10
+#define PACKET_RECEPTION_MAX_SAMPLES 16
+#define PACKET_RECEPTION_MAX_PAYLOAD_BYTES \
+    (PACKET_RECEPTION_HEADER_BYTES + PACKET_RECEPTION_SAMPLE_BYTES * PACKET_RECEPTION_MAX_SAMPLES)
+
+// Sixteen nominal 6.25 ms bins cover the first 100 ms after a snapshot.
+#define PACKET_RECEPTION_BIN_US 6250
+#define PACKET_RECEPTION_MAX_INTERVAL_US 2000000
+#define PACKET_RECEPTION_MAX_SAMPLE_AGE_US 2000000
+
+#define PACKET_RECEPTION_FLAG_HAS_ACCEPTED 0x01
+#define PACKET_RECEPTION_FLAG_INCOMPLETE 0x02
+#define PACKET_RECEPTION_FLAG_CLOCK_UNAVAILABLE 0x04
+#define PACKET_RECEPTION_FLAG_TIMING_SAMPLE_LIMIT 0x08
+#define PACKET_RECEPTION_FLAGS_DEFINED 0x0F
+
+// Result of reading the host's DESCRIBE offer.
+#define PACKET_RECEPTION_OFFER_ABSENT 0
+#define PACKET_RECEPTION_OFFER_VERSION_1 1
+#define PACKET_RECEPTION_OFFER_REFUSED (-1)
+
