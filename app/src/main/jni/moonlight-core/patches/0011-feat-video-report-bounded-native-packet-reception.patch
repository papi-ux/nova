+++ b/src/Platform.c
@@ -437,6 +437,35 @@ uint64_t PltGetMillis(void) {
 #endif
 }
 
+// Monotonic microseconds with an explicit failure result. Unlike PltGetMillis(), there is no
+// wall-clock fallback: a caller that needs monotonic time must be able to tell it has none.
+bool PltGetMonotonicMicros(uint64_t* nowUs) {
+#if defined(LC_WINDOWS)
+    LARGE_INTEGER frequency, counter;
+
+    if (!QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0 ||
+            !QueryPerformanceCounter(&counter) || counter.QuadPart < 0) {
+        return false;
+    }
+
+    *nowUs = ((uint64_t)counter.QuadPart / (uint64_t)frequency.QuadPart) * 1000000 +
+             (((uint64_t)counter.QuadPart % (uint64_t)frequency.QuadPart) * 1000000) / (uint64_t)frequency.QuadPart;
+    return true;
+#elif defined(CLOCK_MONOTONIC) && !defined(NO_CLOCK_GETTIME)
+    struct timespec tv;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &tv) != 0 || tv.tv_sec < 0 || tv.tv_nsec < 0 || tv.tv_nsec >= 1000000000L) {
+        return false;
+    }
+
+    *nowUs = ((uint64_t)tv.tv_sec * 1000000) + ((uint64_t)tv.tv_nsec / 1000);
+    return true;
+#else
+    (void)nowUs;
+    return false;
+#endif
+}
