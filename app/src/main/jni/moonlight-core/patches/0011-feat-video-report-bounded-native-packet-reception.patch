+// They are plain locals there; nothing here points into a packet buffer.
+typedef struct _PACKET_RECEPTION_CAPTURE {
+    uint64_t socketReadUs;
+    uint32_t udpBytes;
+    bool clockValid;
+} PACKET_RECEPTION_CAPTURE, *PPACKET_RECEPTION_CAPTURE;
+
+// Internal sample: monotonic socket-read time plus the packet's original identity.
+typedef struct _PACKET_RECEPTION_SAMPLE {
+    uint64_t socketReadUs;
+    uint32_t frameIndex;
+    uint16_t rtpSequence;
+    uint16_t reserved;
+} PACKET_RECEPTION_SAMPLE;
+
+typedef struct _PACKET_RECEPTION_REPORT_SAMPLE {
+    uint32_t frameIndex;
+    uint16_t rtpSequence;
+    uint32_t socketReadAgeUs;
+} PACKET_RECEPTION_REPORT_SAMPLE;
+
+// One decoded report, before or after its fixed big-endian encoding.
+typedef struct _PACKET_RECEPTION_REPORT {
+    uint8_t flags;
+    uint8_t sampleCount;
+    uint32_t reportSequence;
+    uint32_t intervalUs;
+    uint64_t intervalEndUs;
+    uint32_t receiveLoopTick;
+    uint32_t acceptedDataPackets;
+    uint32_t acceptedParityPackets;
+    uint32_t acceptedDataUdpBytes;
+    uint32_t acceptedParityUdpBytes;
+    uint32_t lastAcceptedAgeUs;
+    uint32_t firstFrame;
+    uint32_t lastFrame;
+    PACKET_RECEPTION_REPORT_SAMPLE samples[PACKET_RECEPTION_MAX_SAMPLES];
+} PACKET_RECEPTION_REPORT, *PPACKET_RECEPTION_REPORT;
+
+// Fixed-size collector state. All times are monotonic microseconds from one clock source.
+typedef struct _PACKET_RECEPTION_COLLECTOR {
+    bool clockFailed;
+    bool retired;
+    bool hasLastAccepted;
+    bool windowHasAccepted;
+    bool windowIncomplete;
+    bool windowSampleLimit;
+    uint16_t windowBinMask;
+    uint8_t windowSampleCount;
+    uint64_t originUs;
+    uint64_t windowStartUs;
+    uint64_t lastClockUs;
+    // Latest clock fact the receive thread itself observed (socket read or commit), so its reads
+    // are checked in that thread's own order even when the packet is never accepted.
+    uint64_t receiverLastClockUs;
+    uint64_t lastAcceptedUs;
+    uint32_t lastSequence;
+    uint32_t receiveLoopTick;
+    uint32_t windowPackets[2];
+    uint32_t windowUdpBytes[2];
+    uint32_t windowFirstFrame;
+    uint32_t windowLastFrame;
+    PACKET_RECEPTION_SAMPLE windowSamples[PACKET_RECEPTION_MAX_SAMPLES];
+} PACKET_RECEPTION_COLLECTOR, *PPACKET_RECEPTION_COLLECTOR;
+
+// Pure collector operations. They never read a clock, lock or allocate: callers pass the time
+// they read and serialize access. The production entrypoints below do exactly that.
+void PacketReceptionCollectorStart(PPACKET_RECEPTION_COLLECTOR collector, bool clockValid, uint64_t originUs);
+void PacketReceptionCollectorNoteReceiveCall(PPACKET_RECEPTION_COLLECTOR collector);
+void PacketReceptionCollectorNoteSocketRead(PPACKET_RECEPTION_COLLECTOR collector, const PACKET_RECEPTION_CAPTURE* capture);
+void PacketReceptionCollectorCommit(PPACKET_RECEPTION_COLLECTOR collector, const PACKET_RECEPTION_CAPTURE* capture,
+                                    bool clockValid, uint64_t commitUs,
+                                    uint32_t frameIndex, uint16_t rtpSequence, bool isParity);
+bool PacketReceptionCollectorTakeReport(PPACKET_RECEPTION_COLLECTOR collector, bool clockValid, uint64_t nowUs,
+                                        PPACKET_RECEPTION_REPORT report);
+void PacketReceptionCollectorRetire(PPACKET_RECEPTION_COLLECTOR collector);
+
+// Exact big-endian encoding. Returns the encoded length (52 + 10 * sampleCount), or -1 if the
+// report cannot be represented or the buffer is too small. Never writes past bufferLength.
+int PacketReceptionSerialize(const PACKET_RECEPTION_REPORT* report, uint8_t* buffer, size_t bufferLength);
+
+// Reads the host DESCRIBE offer: exactly one attribute carrying the single token "1" after trimming
+// surrounding ASCII whitespace. Malformed, unknown or duplicated (even identical) refuses it.
+int PacketReceptionParseHostOffer(const char* sdpPayload);
+
+// All gates the extension requires. Encrypted control v2 is mandatory; video encryption is observed
+// in either existing mode and never requested or changed by this extension.
+bool PacketReceptionGatesPass(bool sunshine, bool encryptedControlProtocol13, int hostOffer,
+                              bool controlConnectDataPresent, uint32_t encryptionEnabled, bool clockSupported);
+
+// Production lifecycle, called by the RTSP, control and video stream code.
+void PacketReceptionResetNegotiation(void);
+void PacketReceptionNoteHostOffer(const char* describePayload);
+void PacketReceptionNoteControlConnectData(bool present);
+bool PacketReceptionNegotiate(void);
+void PacketReceptionNegotiationWithdrawn(void);
+void PacketReceptionStart(bool controlPathEligible);
+bool PacketReceptionIsEnabled(void);
+void PacketReceptionNoteReceive(int receiveResult, PPACKET_RECEPTION_CAPTURE capture);
+void PacketReceptionCommit(const PACKET_RECEPTION_CAPTURE* capture, uint32_t frameIndex, uint16_t rtpSequence, bool isParity);
+int PacketReceptionTakeReport(uint8_t* buffer, size_t bufferLength);
+void PacketReceptionStop(void);
+void PacketReceptionDestroy(void);
+
+#ifdef NOVA_PACKET_RECEPTION_TEST
+// Test-only clock replacement for lifecycle fixtures. Production builds have no such hook.
+void PacketReceptionSetTestClock(bool (*clock)(uint64_t* nowUs));
+// Test-only observation of the window between a snapshot leaving the collector mutex and its
+// enqueue by the control stream, and of collector retirement. Production builds have neither.
+void PacketReceptionSetTestPublicationHook(void (*hook)(const uint8_t* report, int length));
+bool PacketReceptionTestIsRetired(void);
+#endif
