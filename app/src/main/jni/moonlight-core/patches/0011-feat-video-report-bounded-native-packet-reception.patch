diff --git a/src/PacketReception.c b/src/PacketReception.c
new file mode 100644
index 0000000..ed34832
--- /dev/null
+++ b/src/PacketReception.c
@@ -0,0 +1,542 @@
+#include "Limelight-internal.h"
+
+// Observation-only accepted-original RTP reception report. See PacketReception.h.
+
+// The internal sample stays one fixed 16-byte record so the collector remains a bounded array.
+typedef char PacketReceptionSampleSizeCheck[(sizeof(PACKET_RECEPTION_SAMPLE) == 16) ? 1 : -1];
+typedef char PacketReceptionPayloadSizeCheck[(PACKET_RECEPTION_MAX_PAYLOAD_BYTES == 212) ? 1 : -1];
+
+static bool isAsciiSpace(char c) {
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\v' || c == '\f';
+}
+
+int PacketReceptionParseHostOffer(const char* sdpPayload) {
+    static const char prefix[] = "a=" PACKET_RECEPTION_HOST_ATTRIBUTE;
+    const size_t prefixLength = sizeof(prefix) - 1;
+    const char* line;
+    int result = PACKET_RECEPTION_OFFER_ABSENT;
+
+    if (sdpPayload == NULL) {
+        return PACKET_RECEPTION_OFFER_ABSENT;
+    }
+
+    line = sdpPayload;
+    while (*line != 0) {
+        const char* newline = strchr(line, '\n');
+        const char* lineEnd = newline != NULL ? newline : line + strlen(line);
+
+        if ((size_t)(lineEnd - line) >= prefixLength && memcmp(line, prefix, prefixLength) == 0) {
+            const char* value = line + prefixLength;
+
+            // A longer attribute name that merely shares this prefix is someone else's attribute.
+            if (value == lineEnd || *value == ':' || isAsciiSpace(*value)) {
+                const char* valueEnd;
+
+                if (value == lineEnd || *value != ':') {
+                    return PACKET_RECEPTION_OFFER_REFUSED;
+                }
+
+                value++;
+                while (value < lineEnd && isAsciiSpace(*value)) {
+                    value++;
+                }
+                valueEnd = lineEnd;
+                while (valueEnd > value && isAsciiSpace(valueEnd[-1])) {
+                    valueEnd--;
+                }
+
+                // Exactly one attribute with exactly one token, "1". Anything else, including an
+                // identical duplicate, refuses only this extension.
+                if (valueEnd - value != 1 || *value != '1' || result != PACKET_RECEPTION_OFFER_ABSENT) {
+                    return PACKET_RECEPTION_OFFER_REFUSED;
+                }
+                result = PACKET_RECEPTION_OFFER_VERSION_1;
+            }
+        }
+
+        if (newline == NULL) {
+            break;
+        }
+        line = newline + 1;
+    }
+
+    return result;
+}
+
+bool PacketReceptionGatesPass(bool sunshine, bool encryptedControlProtocol13, int hostOffer,
+                              bool controlConnectDataPresent, uint32_t encryptionEnabled, bool clockSupported) {
+    // SS_ENC_VIDEO is deliberately not a gate: plaintext LAN video is observed too, and the host
+    // labels media authentication from its own session settings.
+    return sunshine &&
+           encryptedControlProtocol13 &&
+           hostOffer == PACKET_RECEPTION_OFFER_VERSION_1 &&
+           controlConnectDataPresent &&
+           (encryptionEnabled & SS_ENC_CONTROL_V2) != 0 &&
+           clockSupported;
+}
+
+void PacketReceptionCollectorStart(PPACKET_RECEPTION_COLLECTOR collector, bool clockValid, uint64_t originUs) {
+    memset(collector, 0, sizeof(*collector));
+    if (!clockValid) {
+        // Negotiated but unable to time anything: the first tick reports the clock failure.
+        collector->clockFailed = true;
+        return;
+    }
+
+    collector->originUs = originUs;
+    collector->windowStartUs = originUs;
+    collector->lastClockUs = originUs;
+    collector->receiverLastClockUs = originUs;
+}
+
+void PacketReceptionCollectorNoteReceiveCall(PPACKET_RECEPTION_COLLECTOR collector) {
+    if (!collector->retired) {
+        // Serial progress counter; consumers compare deltas, so wrapping is expected.
+        collector->receiveLoopTick++;
+    }
+}
+
+void PacketReceptionCollectorNoteSocketRead(PPACKET_RECEPTION_COLLECTOR collector, const PACKET_RECEPTION_CAPTURE* capture) {
+    if (collector->retired || collector->clockFailed) {
+        return;
+    }
+
+    // A failed or backward socket-read clock ends timing whether or not the packet is accepted
+    // later; the packet itself is not counted here. Compare only with the receive thread's own
+    // earlier facts: a control snapshot may read a later time between this read and the mutex,
+    // so lastClockUs is not a bound for a read taken before that snapshot.
+    if (!capture->clockValid || capture->socketReadUs < collector->receiverLastClockUs) {
+        collector->clockFailed = true;
+        return;
+    }
+    collector->receiverLastClockUs = capture->socketReadUs;
+
+    // Once this check completes under the mutex, every later snapshot or commit reads its clock
+    // after this read, so the read also raises their floor. It never lowers it: a read taken
+    // before an earlier snapshot leaves that snapshot's higher floor in place.
+    if (capture->socketReadUs > collector->lastClockUs) {
+        collector->lastClockUs = capture->socketReadUs;
+    }
+}
+
+static void addSaturating(uint32_t* value, uint32_t amount, bool* saturated) {
+    if (UINT32_MAX - *value < amount) {
+        *value = UINT32_MAX;
+        *saturated = true;
+    }
+    else {
+        *value += amount;
+    }
+}
+
+void PacketReceptionCollectorCommit(PPACKET_RECEPTION_COLLECTOR collector, const PACKET_RECEPTION_CAPTURE* capture,
+                                    bool clockValid, uint64_t commitUs,
+                                    uint32_t frameIndex, uint16_t rtpSequence, bool isParity) {
+    const int kind = isParity ? 1 : 0;
+    uint64_t bin;
+    PACKET_RECEPTION_SAMPLE* sample;
+
+    if (collector->retired) {
+        return;
+    }
+
+    // The socket read happened earlier on this same thread, after the collector origin. A failed
+    // read or any time running backwards ends timing for this native connection.
+    if (!collector->clockFailed &&
+            (!clockValid || !capture->clockValid ||
+             commitUs < collector->lastClockUs ||
+             capture->socketReadUs > commitUs ||
+             capture->socketReadUs < collector->originUs)) {
+        collector->clockFailed = true;
+    }
+
+    // Counts belong to the interval in which the packet was accepted, not the one it was read in.
+    addSaturating(&collector->windowPackets[kind], 1, &collector->windowIncomplete);
+    addSaturating(&collector->windowUdpBytes[kind], capture->udpBytes, &collector->windowIncomplete);
+    if (!collector->windowHasAccepted) {
+        collector->windowHasAccepted = true;
+        collector->windowFirstFrame = frameIndex;
+        collector->windowLastFrame = frameIndex;
+    }
+    else {
+        if (frameIndex < collector->windowFirstFrame) {
+            collector->windowFirstFrame = frameIndex;
+        }
+        if (frameIndex > collector->windowLastFrame) {
+            collector->windowLastFrame = frameIndex;
+        }
+    }
+
+    if (collector->clockFailed) {
+        return;
+    }
+
+    collector->lastClockUs = commitUs;
+    collector->receiverLastClockUs = commitUs;
+    collector->lastAcceptedUs = commitUs;
+    collector->hasLastAccepted = true;
+
+    // First accepted original per nominal bin, at most sixteen, never replaced. The sample keeps
+    // the earlier socket-read time even when acceptance happened later.
+    bin = (commitUs - collector->windowStartUs) / PACKET_RECEPTION_BIN_US;
+    if (bin >= PACKET_RECEPTION_MAX_SAMPLES) {
+        collector->windowSampleLimit = true;
+        return;
+    }
+    if (collector->windowBinMask & (1u << bin)) {
+        return;
+    }
+
+    LC_ASSERT(collector->windowSampleCount < PACKET_RECEPTION_MAX_SAMPLES);
+    collector->windowBinMask |= (uint16_t)(1u << bin);
+    sample = &collector->windowSamples[collector->windowSampleCount++];
+    sample->socketReadUs = capture->socketReadUs;
+    sample->frameIndex = frameIndex;
+    sample->rtpSequence = rtpSequence;
+    sample->reserved = 0;
+}
+
+static void resetWindow(PPACKET_RECEPTION_COLLECTOR collector) {
+    collector->windowHasAccepted = false;
+    collector->windowIncomplete = false;
+    collector->windowSampleLimit = false;
+    collector->windowBinMask = 0;
+    collector->windowSampleCount = 0;
+    collector->windowPackets[0] = collector->windowPackets[1] = 0;
+    collector->windowUdpBytes[0] = collector->windowUdpBytes[1] = 0;
+    collector->windowFirstFrame = collector->windowLastFrame = 0;
+}
+
+bool PacketReceptionCollectorTakeReport(PPACKET_RECEPTION_COLLECTOR collector, bool clockValid, uint64_t nowUs,
+                                        PPACKET_RECEPTION_REPORT report) {
+    uint64_t intervalUs;
+    bool longInterval;
+    uint8_t i;
+
+    if (collector->retired) {
+        return false;
+    }
+
+    // Stop before the report sequence could wrap.
+    if (collector->lastSequence == UINT32_MAX) {
+        collector->retired = true;
+        return false;
+    }
+
+    if (!collector->clockFailed && (!clockValid || nowUs < collector->lastClockUs)) {
+        collector->clockFailed = true;
+    }
+
+    // A zero-length interval has nothing to report and does not consume a sequence number.
+    if (!collector->clockFailed && nowUs == collector->windowStartUs) {
+        return false;
+    }
+
+    memset(report, 0, sizeof(*report));
+    report->reportSequence = ++collector->lastSequence;
+    report->receiveLoopTick = collector->receiveLoopTick;
+    report->acceptedDataPackets = collector->windowPackets[0];
+    report->acceptedParityPackets = collector->windowPackets[1];
+    report->acceptedDataUdpBytes = collector->windowUdpBytes[0];
+    report->acceptedParityUdpBytes = collector->windowUdpBytes[1];
+    if (collector->windowHasAccepted) {
+        report->flags |= PACKET_RECEPTION_FLAG_HAS_ACCEPTED;
+        report->firstFrame = collector->windowFirstFrame;
+        report->lastFrame = collector->windowLastFrame;
+    }
+
+    if (collector->clockFailed) {
+        // One zero-time sentinel, then nothing until a fresh native connection.
+        report->flags |= PACKET_RECEPTION_FLAG_INCOMPLETE | PACKET_RECEPTION_FLAG_CLOCK_UNAVAILABLE;
+        report->intervalUs = 0;
+        report->intervalEndUs = 0;
+        report->lastAcceptedAgeUs = UINT32_MAX;
+        report->sampleCount = 0;
+        collector->retired = true;
+        resetWindow(collector);
+        return true;
+    }
+
+    intervalUs = nowUs - collector->windowStartUs;
+    longInterval = intervalUs > PACKET_RECEPTION_MAX_INTERVAL_US;
+    report->intervalUs = intervalUs > UINT32_MAX ? UINT32_MAX : (uint32_t)intervalUs;
+    report->intervalEndUs = nowUs - collector->originUs;
+    if (longInterval || collector->windowIncomplete) {
+        report->flags |= PACKET_RECEPTION_FLAG_INCOMPLETE;
+    }
+    if (collector->windowSampleLimit) {
+        report->flags |= PACKET_RECEPTION_FLAG_TIMING_SAMPLE_LIMIT;
+    }
+
+    if (collector->hasLastAccepted) {
+        uint64_t age = nowUs - collector->lastAcceptedUs;
+        report->lastAcceptedAgeUs = age >= UINT32_MAX ? UINT32_MAX : (uint32_t)age;
+    }
+    else {
+        report->lastAcceptedAgeUs = UINT32_MAX;
+    }
+
+    // A long or saturated scheduling interval carries no timing samples at all.
+    if (!longInterval) {
+        for (i = 0; i < collector->windowSampleCount; i++) {
+            const PACKET_RECEPTION_SAMPLE* sample = &collector->windowSamples[i];
+            uint64_t age = nowUs - sample->socketReadUs;
+
+            if (age > PACKET_RECEPTION_MAX_SAMPLE_AGE_US || age > report->intervalEndUs) {
+                // Too old to describe: omit it rather than move it, and say so.
+                report->flags |= PACKET_RECEPTION_FLAG_INCOMPLETE;
+                continue;
+            }
+
+            report->samples[report->sampleCount].frameIndex = sample->frameIndex;
+            report->samples[report->sampleCount].rtpSequence = sample->rtpSequence;
+            report->samples[report->sampleCount].socketReadAgeUs = (uint32_t)age;
+            report->sampleCount++;
+        }
+    }
+
+    collector->windowStartUs = nowUs;
+    collector->lastClockUs = nowUs;
+    resetWindow(collector);
+    return true;
+}
+
+void PacketReceptionCollectorRetire(PPACKET_RECEPTION_COLLECTOR collector) {
+    collector->retired = true;
+}
+
+static void putBe16(uint8_t* p, uint16_t value) {
+    p[0] = (uint8_t)(value >> 8);
+    p[1] = (uint8_t)value;
+}
+
+static void putBe32(uint8_t* p, uint32_t value) {
+    p[0] = (uint8_t)(value >> 24);
+    p[1] = (uint8_t)(value >> 16);
+    p[2] = (uint8_t)(value >> 8);
+    p[3] = (uint8_t)value;
+}
+
+static void putBe64(uint8_t* p, uint64_t value) {
+    putBe32(p, (uint32_t)(value >> 32));
+    putBe32(p + 4, (uint32_t)value);
+}
+
+int PacketReceptionSerialize(const PACKET_RECEPTION_REPORT* report, uint8_t* buffer, size_t bufferLength) {
+    size_t length;
+    uint8_t i;
+
+    if (report == NULL || buffer == NULL ||
+            report->sampleCount > PACKET_RECEPTION_MAX_SAMPLES ||
+            (report->flags & ~PACKET_RECEPTION_FLAGS_DEFINED) != 0) {
+        return -1;
+    }
+
+    length = PACKET_RECEPTION_HEADER_BYTES + (size_t)PACKET_RECEPTION_SAMPLE_BYTES * report->sampleCount;
+    if (bufferLength < length) {
+        return -1;
+    }
+
+    buffer[0] = PACKET_RECEPTION_VERSION;
+    buffer[1] = report->flags;
+    buffer[2] = report->sampleCount;
+    buffer[3] = 0;
+    putBe32(buffer + 4, report->reportSequence);
+    putBe32(buffer + 8, report->intervalUs);
+    putBe64(buffer + 12, report->intervalEndUs);
+    putBe32(buffer + 20, report->receiveLoopTick);
+    putBe32(buffer + 24, report->acceptedDataPackets);
+    putBe32(buffer + 28, report->acceptedParityPackets);
+    putBe32(buffer + 32, report->acceptedDataUdpBytes);
+    putBe32(buffer + 36, report->acceptedParityUdpBytes);
+    putBe32(buffer + 40, report->lastAcceptedAgeUs);
+    putBe32(buffer + 44, report->firstFrame);
+    putBe32(buffer + 48, report->lastFrame);
+
+    for (i = 0; i < report->sampleCount; i++) {
+        uint8_t* sample = buffer + PACKET_RECEPTION_HEADER_BYTES + (size_t)PACKET_RECEPTION_SAMPLE_BYTES * i;
+        putBe32(sample, report->samples[i].frameIndex);
+        putBe16(sample + 4, report->samples[i].rtpSequence);
+        putBe32(sample + 6, report->samples[i].socketReadAgeUs);
+    }
+
+    return (int)length;
+}
+
+// Production state. collectorEnabled is written only before the control and video threads that
+// use it are created, and after they are joined; everything else they touch is under the mutex.
+static PACKET_RECEPTION_COLLECTOR collector;
+static PLT_MUTEX collectorMutex;
+static bool collectorEnabled;
+static int hostOffer;
+static bool controlConnectDataPresent;
+static bool negotiated;
+static bool (*receptionClock)(uint64_t* nowUs) = PltGetMonotonicMicros;
+
+#ifdef NOVA_PACKET_RECEPTION_TEST
+static void (*testPublicationHook)(const uint8_t* report, int length);
+
+void PacketReceptionSetTestClock(bool (*clock)(uint64_t* nowUs)) {
+    receptionClock = clock != NULL ? clock : PltGetMonotonicMicros;
+}
+
+void PacketReceptionSetTestPublicationHook(void (*hook)(const uint8_t* report, int length)) {
+    testPublicationHook = hook;
+}
+
+bool PacketReceptionTestIsRetired(void) {
+    bool retired;
+
+    if (!collectorEnabled) {
+        return false;
+    }
+    PltLockMutex(&collectorMutex);
+    retired = collector.retired;
+    PltUnlockMutex(&collectorMutex);
+    return retired;
+}
+#endif
+
+void PacketReceptionResetNegotiation(void) {
+    LC_ASSERT(!collectorEnabled);
+    hostOffer = PACKET_RECEPTION_OFFER_ABSENT;
+    controlConnectDataPresent = false;
+    negotiated = false;
+}
+
+void PacketReceptionNoteHostOffer(const char* describePayload) {
+    hostOffer = PacketReceptionParseHostOffer(describePayload);
+    if (hostOffer == PACKET_RECEPTION_OFFER_REFUSED) {
+        Limelog("Packet reception feedback offer is malformed or unsupported; leaving it off\n");
+    }
+}
+
+void PacketReceptionNoteControlConnectData(bool present) {
+    controlConnectDataPresent = present;
+}
+
+bool PacketReceptionNegotiate(void) {
+    uint64_t probeUs = 0;
+
+    negotiated = PacketReceptionGatesPass(IS_SUNSHINE(), APP_VERSION_AT_LEAST(7, 1, 431), hostOffer,
+                                          controlConnectDataPresent, EncryptionFeaturesEnabled, true) &&
+                 receptionClock(&probeUs);
+    return negotiated;
+}
+
+void PacketReceptionNegotiationWithdrawn(void) {
+    negotiated = false;
+}
+
+void PacketReceptionStart(bool controlPathEligible) {
+    uint64_t originUs = 0;
+    bool clockValid;
+
+    LC_ASSERT(!collectorEnabled);
+    if (!negotiated || !controlPathEligible) {
+        return;
+    }
+
+    if (PltCreateMutex(&collectorMutex) != 0) {
+        Limelog("Packet reception feedback unavailable: mutex creation failed\n");
+        return;
+    }
+
+    clockValid = receptionClock(&originUs);
+    PacketReceptionCollectorStart(&collector, clockValid, originUs);
+    collectorEnabled = true;
+}
+
+bool PacketReceptionIsEnabled(void) {
+    return collectorEnabled;
+}
+
+void PacketReceptionNoteReceive(int receiveResult, PPACKET_RECEPTION_CAPTURE capture) {
+    if (!collectorEnabled) {
+        return;
+    }
+
+    if (receiveResult > 0) {
+        capture->socketReadUs = 0;
+        capture->clockValid = receptionClock(&capture->socketReadUs);
+        capture->udpBytes = (uint32_t)receiveResult;
+    }
+
+    // The time above stays the read made right after the socket returned; only its check
+    // against the receive thread's earlier facts happens under the mutex.
+    if (receiveResult >= 0) {
+        PltLockMutex(&collectorMutex);
+        if (receiveResult > 0) {
+            PacketReceptionCollectorNoteSocketRead(&collector, capture);
+        }
+        PacketReceptionCollectorNoteReceiveCall(&collector);
+        PltUnlockMutex(&collectorMutex);
+    }
+}
+
+void PacketReceptionCommit(const PACKET_RECEPTION_CAPTURE* capture, uint32_t frameIndex, uint16_t rtpSequence, bool isParity) {
+    uint64_t commitUs = 0;
+    bool clockValid;
+
+    if (!collectorEnabled || capture == NULL) {
+        return;
+    }
+
+    // The clock is read under the lock so commit and snapshot times are ordered.
+    PltLockMutex(&collectorMutex);
+    clockValid = receptionClock(&commitUs);
+    PacketReceptionCollectorCommit(&collector, capture, clockValid, commitUs, frameIndex, rtpSequence, isParity);
+    PltUnlockMutex(&collectorMutex);
+}
+
+int PacketReceptionTakeReport(uint8_t* buffer, size_t bufferLength) {
+    PACKET_RECEPTION_REPORT report;
+    uint64_t nowUs = 0;
+    bool clockValid;
+    bool take;
+    int length;
+
+    if (!collectorEnabled) {
+        return 0;
+    }
+
+    PltLockMutex(&collectorMutex);
+    clockValid = receptionClock(&nowUs);
+    take = PacketReceptionCollectorTakeReport(&collector, clockValid, nowUs, &report);
+    PltUnlockMutex(&collectorMutex);
+
+    if (!take) {
+        return 0;
+    }
+
+    // Encoded outside the lock, so the receive thread never waits on encoding or ENet.
+    length = PacketReceptionSerialize(&report, buffer, bufferLength);
+#ifdef NOVA_PACKET_RECEPTION_TEST
+    if (length > 0 && testPublicationHook != NULL) {
+        testPublicationHook(buffer, length);
+    }
+#endif
+    return length > 0 ? length : 0;
+}
+
+void PacketReceptionStop(void) {
+    if (!collectorEnabled) {
+        return;
+    }
+
+    PltLockMutex(&collectorMutex);
+    PacketReceptionCollectorRetire(&collector);
+    PltUnlockMutex(&collectorMutex);
+}
+
+void PacketReceptionDestroy(void) {
+    if (collectorEnabled) {
+        PltDeleteMutex(&collectorMutex);
+        collectorEnabled = false;
+    }
+
+    memset(&collector, 0, sizeof(collector));
+    hostOffer = PACKET_RECEPTION_OFFER_ABSENT;
+    controlConnectDataPresent = false;
+    negotiated = false;
+}
