<?xml version="1.0" encoding="utf-8"?>
<!-- The one chevron of Nova's panels: a row that opens a page, a page's way back, a value's steps.
     A drawing, not a character, so it keeps its 18dp at every font scale. It mirrors in a right to
     left layout. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="18dp"
    android:height="18dp"
    android:autoMirrored="true"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M9.5,5.5L16,12L9.5,18.5"
        android:strokeWidth="2.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
