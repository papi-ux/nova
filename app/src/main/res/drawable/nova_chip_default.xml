<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceVariant" />
            <stroke
                android:width="3dp"
                android:color="?attr/colorAccent" />
            <corners android:radius="@dimen/nova_radius_hero" />
        </shape>
    </item>
    <!-- Activated and selected rest like any chip: fills and borders only ever mean focus (R9).
         Manage carried an accent outline at rest and read as a second focus beside the ring. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceVariant" />
            <stroke
                android:width="1dp"
                android:color="#18c8d6e5" />
            <corners android:radius="@dimen/nova_radius_hero" />
        </shape>
    </item>
</selector>
