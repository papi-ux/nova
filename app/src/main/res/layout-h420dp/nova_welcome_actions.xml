<?xml version="1.0" encoding="utf-8"?>
<!-- Screens with the height for a second row, such as the 4:3 Retroid Pocket Nova
     (640 x 480dp). Three buttons in one 300dp column left each about 100dp there,
     and "Discover hosts" wrapped onto three lines with the last one clipped, so the
     primary action takes the full width and the other two share the row under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/welcome_discover_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:focusable="true"
        android:nextFocusDown="@id/welcome_add_manual_btn"
        android:text="Discover hosts"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="?attr/colorAccent"
        app:cornerRadius="25dp"
        app:strokeColor="@color/nova_focus_stroke_selector"
        app:strokeWidth="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/welcome_add_manual_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:focusable="true"
            android:nextFocusRight="@id/welcome_scan_qr_btn"
            android:nextFocusUp="@id/welcome_discover_btn"
            android:text="Add manually"
            android:textAllCaps="false"
            android:textColor="?android:attr/textColorPrimary"
            app:cornerRadius="25dp"
            app:strokeColor="@color/nova_focus_stroke_selector"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/welcome_scan_qr_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:focusable="true"
            android:nextFocusLeft="@id/welcome_add_manual_btn"
            android:nextFocusUp="@id/welcome_discover_btn"
            android:text="Scan QR"
            android:textAllCaps="false"
            android:textColor="?android:attr/textColorPrimary"
            app:cornerRadius="25dp"
            app:strokeColor="@color/nova_focus_stroke_selector"
            app:strokeWidth="2dp" />
    </LinearLayout>
</LinearLayout>
