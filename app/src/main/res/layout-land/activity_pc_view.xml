<!-- Nova server browser -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".PcView">

    <com.papi.nova.ui.SpaceParticleView
        android:id="@+id/space_particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dashboardCockpit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/dashboardCockpitRail"
            android:layout_width="@dimen/nova_dashboard_rail_width"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/pcViewHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboardRailToggle"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@string/pcview_rail_collapse"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="34dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text=""
                        android:textAllCaps="false"
                        app:backgroundTint="?attr/colorControlHighlight"
                        app:cornerRadius="17dp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_menu_collapse"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/pcViewTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="0.04"
                        android:tag="dashboardRailLabel"
                        android:text="Nova"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pcViewSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:tag="dashboardRailLabel"
                    android:text="@string/pcview_home_subtitle"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionStartPolaris"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/pcview_quick_start_polaris"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="34dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pcview_quick_start_polaris"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:backgroundTint="?attr/colorControlHighlight"
                    app:cornerRadius="17dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profilesButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:layout_marginTop="5dp"
                    android:contentDescription="@string/pcview_quick_profiles"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="34dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pcview_quick_profiles"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:backgroundTint="?attr/colorControlHighlight"
                    app:cornerRadius="17dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_profiles"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionTheme"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:layout_marginTop="5dp"
                    android:contentDescription="@string/pcview_quick_theme"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="34dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pcview_quick_theme"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:backgroundTint="?attr/colorControlHighlight"
                    app:cornerRadius="17dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_theme_cycle"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionGithub"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:layout_marginTop="5dp"
                    android:contentDescription="@string/pcview_quick_github"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="34dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pcview_quick_github"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:backgroundTint="?attr/colorControlHighlight"
                    app:cornerRadius="17dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_github"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionSettings"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:layout_marginTop="5dp"
                    android:contentDescription="@string/pcview_quick_settings"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="34dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pcview_quick_settings"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:backgroundTint="?attr/colorControlHighlight"
                    app:cornerRadius="17dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/actionNovaUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="38dp"
                    android:layout_marginTop="5dp"
                    android:clickable="true"
                    android:contentDescription="@string/pcview_update_pill_content_current"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="?attr/colorControlHighlight"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorControlHighlight"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <View
                            android:id="@+id/updateStatusLight"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/nova_status_online" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/updateStatusLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:text="@string/pcview_update_status_current"
                                android:textAllCaps="true"
                                android:textColor="?android:textColorSecondary"
                                android:textSize="7sp" />

                            <TextView
                                android:id="@+id/updateVersionLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxWidth="92dp"
                                android:singleLine="true"
                                android:text="@string/pcview_update_version_preview"
                                android:textColor="?android:textColorPrimary"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <LinearLayout
                    android:id="@+id/dashboardHomeControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:tag="dashboardRailLabel"
                        android:text="@string/pcview_browse_label"
                        android:textAllCaps="true"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="8sp" />

                    <LinearLayout
                        android:id="@+id/dashboardModeSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="34dp"
                        android:layout_marginTop="6dp"
                        android:contentDescription="@string/pcview_dashboard_mode_selector"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/modeServers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="34dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:contentDescription="@string/pcview_mode_servers"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/nova_dashboard_pill_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorAccent"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:includeFontPadding="false"
                                android:text="●"
                                android:textColor="?attr/colorAccent"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:text="@string/pcview_mode_servers"
                                android:textColor="?android:textColorPrimary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/modeLibrary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="34dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:contentDescription="@string/pcview_mode_library"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/nova_dashboard_pill_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorControlHighlight"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:includeFontPadding="false"
                                android:text="●"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:text="@string/pcview_mode_library"
                                android:textColor="?android:textColorPrimary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dashboardModeStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:text="@string/pcview_dashboard_mode_status_empty"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="9sp"
                        tools:text="1 online · 1 total · 1 server ready" />

                    <LinearLayout
                        android:id="@+id/setupActionRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/actionAddServer"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="34dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/pcview_quick_add_server"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/pcview_quick_add_server"
                        android:textAllCaps="false"
                        android:textSize="10sp"
                        app:backgroundTint="?attr/colorControlHighlight"
                        app:cornerRadius="17dp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconPadding="5dp"
                        app:iconTint="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/actionScanPair"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="34dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/pcview_quick_scan_pair"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/pcview_quick_scan_pair"
                        android:textAllCaps="false"
                        android:textSize="10sp"
                        app:backgroundTint="?attr/colorControlHighlight"
                        app:cornerRadius="17dp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_qr_scan"
                        app:iconGravity="textStart"
                        app:iconPadding="5dp"
                        app:iconTint="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/topActionFocusLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="14dp"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="9sp"
                    android:visibility="invisible"
                    tools:text="Settings" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/dashboardContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/nova_dashboard_rail_gap">
            <TextView
                android:id="@+id/pcViewHostsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"
                android:text="@string/pcview_hosts_label"
                android:textColor="?android:textColorPrimary"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/serverFilterTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterAllServers"
                        style="@style/NovaMaterialChip"
                        android:checked="true"
                        android:nextFocusDown="@id/serverListFocusBridge"
                        android:text="@string/pcview_filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterOnlineServers"
                        style="@style/NovaMaterialChip"
                        android:nextFocusDown="@id/serverListFocusBridge"
                        android:text="@string/pcview_filter_online" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterStreamingServers"
                        style="@style/NovaMaterialChip"
                        android:nextFocusDown="@id/serverListFocusBridge"
                        android:text="@string/pcview_filter_streaming" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterNeedsPairingServers"
                        style="@style/NovaMaterialChip"
                        android:nextFocusDown="@id/serverListFocusBridge"
                        android:text="@string/pcview_filter_needs_pairing" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <View
                android:id="@+id/serverListFocusBridge"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <RelativeLayout
                android:id="@+id/pcFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/no_pc_found_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:alpha="0.3"
                        android:src="@drawable/ic_nova_star_foreground" />

                    <ProgressBar
                        android:id="@+id/pcs_loading"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="20dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/nova_accent" />

                    <TextView
                        android:id="@+id/pcViewEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/pcview_empty_title_searching"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/pcViewEmptyHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.6"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="@string/pcview_empty_hint_searching"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="12sp" />

                    <HorizontalScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/emptyRefresh"
                                style="@style/NovaFilterChip"
                                android:text="@string/nova_refresh" />

                            <TextView
                                android:id="@+id/emptyAddServer"
                                style="@style/NovaFilterChip"
                                android:text="@string/pcview_quick_add_server" />

                            <TextView
                                android:id="@+id/emptyScanPair"
                                style="@style/NovaFilterChip"
                                android:text="@string/pcview_quick_scan_pair" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </RelativeLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
