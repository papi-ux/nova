<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nova_library_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <com.papi.nova.ui.SpaceParticleView
        android:id="@+id/space_particles_dense"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/nova_library_header"
            android:layout_width="@dimen/nova_library_landscape_rail_width"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/nova_library_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/nova_library_panel_bg"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="9dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nova_library_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/nova_library_title"
                            android:textColor="@color/nova_ice"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/nova_library_context"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/nova_library_server_context_fallback"
                            android:textColor="@color/nova_text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nova_library_back"
                        android:layout_width="40dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/nova_library_tool_action_bg"
                        android:contentDescription="@string/nova_library_switch_server"
                        android:ellipsize="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:singleLine="true"
                        android:text=""
                        android:textAllCaps="false"
                        android:textColor="@color/nova_text_primary"
                        android:textSize="10sp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_computer"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/nova_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nova_library_status_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/nova_command_status_bg"
                    android:orientation="vertical"
                    android:paddingStart="2dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/nova_library_auto_quality_state"
                            style="@style/NovaQuickMenuState"
                            android:text="@string/nova_library_status_checking" />

                        <TextView
                            android:id="@+id/nova_library_mode_state"
                            style="@style/NovaQuickMenuState"
                            android:layout_marginStart="7dp"
                            android:text="@string/nova_library_mode_checking" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nova_library_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/nova_library_summary_placeholder"
                        android:textColor="@color/nova_text_muted"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/nova_library_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/nova_library_results_format"
                        android:textColor="@color/nova_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/nova_search"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/nova_search_height"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/nova_library_search_bg"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="7dp"
                    android:drawableTint="@color/nova_text_muted"
                    android:hint="@string/nova_library_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/nova_text_primary"
                    android:textColorHint="@color/nova_text_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/nova_library_secondary_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nova_library_refresh"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:background="@drawable/nova_library_tool_action_bg"
                        android:ellipsize="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:singleLine="true"
                        android:text="@string/nova_refresh"
                        android:textAllCaps="false"
                        android:textColor="@color/nova_text_primary"
                        android:textSize="10sp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_polaris_sync"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/nova_text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nova_library_manage"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/nova_library_tool_action_bg"
                        android:ellipsize="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:singleLine="true"
                        android:text="@string/nova_library_manage"
                        android:textAllCaps="false"
                        android:textColor="@color/nova_text_primary"
                        android:textSize="10sp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_settings"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/nova_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nova_filter_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/filter_all"
                    style="@style/NovaFilterChip"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/nova_chip_selected"
                    android:text="@string/nova_library_filter_all"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/filter_recent"
                    style="@style/NovaFilterChip"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/nova_library_filter_recent"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/filter_sources"
                    style="@style/NovaFilterChip"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/nova_library_filter_sources"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/filter_hdr"
                    style="@style/NovaFilterChip"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/nova_library_filter_hdr"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/filter_more"
                    style="@style/NovaFilterChip"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginEnd="0dp"
                    android:text="@string/nova_library_filter_more"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nova_recent_section"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="9dp"
                android:layout_weight="1"
                android:background="@drawable/nova_command_panel_bg"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="8dp"
                android:paddingEnd="9dp"
                android:paddingBottom="9dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nova_recent_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/nova_library_continue_label"
                        android:textColor="@color/nova_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/nova_recent_summary"
                        style="@style/NovaQuickMenuState"
                        android:text="@string/nova_library_continue_empty" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/nova_recent_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <include
                android:id="@+id/nova_shimmer_container"
                layout="@layout/nova_shimmer_game_grid" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/nova_swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/nova_game_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="0dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="@dimen/nova_spacing_lg" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/nova_empty_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/nova_empty_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/nova_command_panel_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:alpha="0.42"
                        android:src="@drawable/ic_nova_star_foreground" />

                    <TextView
                        android:id="@+id/nova_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/nova_library_empty_title_default"
                        android:textColor="@color/nova_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/nova_empty_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="@string/nova_library_empty_hint_default"
                        android:textColor="@color/nova_text_muted"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nova_empty_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/nova_library_tool_action_bg"
                        android:minWidth="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/nova_retry"
                        android:textAllCaps="false"
                        android:textColor="@color/nova_text_primary"
                        android:textSize="12sp"
                        app:elevation="0dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
