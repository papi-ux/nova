<?xml version="1.0" encoding="utf-8"?>
<!-- Three buttons share one row, a third of it each on a landscape phone. Each keeps its label on
     one line and sizes it down to fit, where a wrap inside the fixed 50dp clipped its second line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/welcome_discover_btn"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:focusable="true"
        android:nextFocusRight="@id/welcome_add_manual_btn"
        android:maxLines="1"
        android:text="@string/nova_welcome_discover"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        app:autoSizeMaxTextSize="15sp"
        app:autoSizeMinTextSize="11sp"
        app:autoSizeTextType="uniform"
        android:textStyle="bold"
        app:backgroundTint="?attr/colorAccent"
        app:cornerRadius="25dp"
        app:strokeColor="@color/nova_focus_stroke_selector"
        app:strokeWidth="2dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/welcome_add_manual_btn"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:focusable="true"
        android:nextFocusLeft="@id/welcome_discover_btn"
        android:nextFocusRight="@id/welcome_scan_qr_btn"
        android:maxLines="1"
        android:text="@string/nova_welcome_add_manually"
        android:textAllCaps="false"
        android:textColor="?android:attr/textColorPrimary"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="11sp"
        app:autoSizeTextType="uniform"
        app:cornerRadius="25dp"
        app:strokeColor="@color/nova_focus_stroke_selector"
        app:strokeWidth="2dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/welcome_scan_qr_btn"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:focusable="true"
        android:nextFocusLeft="@id/welcome_add_manual_btn"
        android:maxLines="1"
        android:text="@string/nova_welcome_scan_qr"
        android:textAllCaps="false"
        android:textColor="?android:attr/textColorPrimary"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="11sp"
        app:autoSizeTextType="uniform"
        app:cornerRadius="25dp"
        app:strokeColor="@color/nova_focus_stroke_selector"
        app:strokeWidth="2dp" />
</LinearLayout>
