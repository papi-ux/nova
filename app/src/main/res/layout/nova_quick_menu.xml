<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nova_quick_menu_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/nova_quick_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/nova_quick_header_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quick_menu_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nova_quick_menu_command_center_title"
                    android:textColor="@color/nova_ice"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/quick_menu_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:text="@string/nova_quick_menu_command_center_subtitle"
                    android:textColor="@color/nova_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/nova_quick_action_bg"
                android:text="@string/game_menu_disconnect"
                android:textAllCaps="false"
                android:textColor="@color/nova_success"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_quit"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/nova_quick_action_danger_bg"
                android:text="@string/nova_quick_menu_end_stream"
                android:textAllCaps="false"
                android:textColor="@color/nova_error"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_menu_session_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/nova_command_status_bg"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/quick_menu_session_mode"
                style="@style/NovaQuickMenuState"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="@string/nova_quick_menu_mode_unknown" />

            <TextView
                android:id="@+id/quick_menu_health_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/nova_quick_menu_health_checking"
                android:textColor="@color/nova_text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_stability_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/nova_auto_quality_panel_bg"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="158dp"
            android:orientation="vertical"
            android:padding="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nova_quick_menu_ai_auto_quality"
                    android:textColor="@color/nova_ice"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/stability_mode_state"
                    style="@style/NovaQuickMenuState"
                    android:text="@string/nova_quick_menu_loading" />
            </LinearLayout>

            <TextView
                android:id="@+id/stability_mode_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:text="@string/nova_quick_menu_auto_quality_caption_default"
                android:textColor="@color/nova_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/auto_quality_target_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nova_quick_menu_target_checking"
                android:textColor="@color/nova_text_muted"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/nova_quick_menu_profile_preference"
                    android:textColor="@color/nova_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/profile_preference_caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/nova_quick_menu_profile_preference_checking"
                    android:textColor="@color/nova_text_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_preference_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_pref_auto"
                    style="@style/NovaQuickMenuSegment"
                    android:layout_weight="1"
                    android:text="@string/nova_auto_quality_preference_auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_pref_quality"
                    style="@style/NovaQuickMenuSegment"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/nova_auto_quality_preference_quality" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_pref_high_fps"
                    style="@style/NovaQuickMenuSegment"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/nova_auto_quality_preference_high_fps" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_pref_stability"
                    style="@style/NovaQuickMenuSegment"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/nova_auto_quality_preference_stability" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/action_bidirectional_sync"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/nova_command_panel_bg"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="82dp"
                android:orientation="vertical"
                android:padding="11dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/nova_quick_menu_sync_status"
                        android:textColor="@color/nova_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/bidirectional_sync_state"
                        style="@style/NovaQuickMenuState"
                        android:text="@string/nova_quick_menu_checking" />
                </LinearLayout>

                <TextView
                    android:id="@+id/bidirectional_sync_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:text="@string/nova_quick_menu_sync_caption_default"
                    android:textColor="@color/nova_text_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_advanced_tuning"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/nova_command_panel_bg"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="82dp"
                android:orientation="vertical"
                android:padding="11dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/nova_quick_menu_advanced_tuning"
                        android:textColor="@color/nova_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/advanced_tuning_state"
                        style="@style/NovaQuickMenuState"
                        android:text="@string/nova_quick_menu_show" />
                </LinearLayout>

                <TextView
                    android:id="@+id/advanced_tuning_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:text="@string/nova_quick_menu_advanced_caption"
                    android:textColor="@color/nova_text_muted"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advanced_tuning_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/nova_command_panel_bg"
            android:orientation="vertical"
            android:padding="11dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/toggle_ai_optimizer"
                style="@style/NovaQuickMenuRow"
                android:layout_width="match_parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/NovaQuickMenuRowTitle"
                        android:text="@string/nova_quick_menu_ai_auto_quality" />

                    <TextView
                        android:id="@+id/ai_optimizer_caption"
                        style="@style/NovaQuickMenuRowCaption"
                        android:text="@string/nova_quick_menu_ai_caption_default" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ai_optimizer_state"
                    style="@style/NovaQuickMenuState"
                    android:text="@string/nova_quick_menu_off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_clear_game_profile"
                style="@style/NovaQuickMenuRow"
                android:layout_width="match_parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/NovaQuickMenuRowTitle"
                        android:text="@string/nova_quick_menu_clear_game_profile" />

                    <TextView
                        android:id="@+id/clear_game_profile_caption"
                        style="@style/NovaQuickMenuRowCaption"
                        android:text="@string/nova_quick_menu_clear_game_profile_caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/clear_game_profile_state"
                    style="@style/NovaQuickMenuState"
                    android:text="@string/nova_quick_menu_clear" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toggle_mangohud"
                style="@style/NovaQuickMenuRow"
                android:layout_width="match_parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/NovaQuickMenuRowTitle"
                        android:text="@string/nova_quick_menu_mangohud" />

                    <TextView
                        android:id="@+id/mangohud_caption"
                        style="@style/NovaQuickMenuRowCaption"
                        android:text="@string/nova_mangohud_quick_menu_caption_default" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mangohud_state"
                    style="@style/NovaQuickMenuState"
                    android:text="@string/nova_quick_menu_queued" />
            </LinearLayout>
        </LinearLayout>

        <GridLayout
            android:id="@+id/quick_keys_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qk_esc"
                style="@style/NovaQuickKey"
                android:layout_columnWeight="1"
                android:text="@string/game_menu_send_keys_esc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qk_alt_enter"
                style="@style/NovaQuickKey"
                android:layout_columnWeight="1"
                android:text="@string/game_menu_send_keys_alt_enter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qk_alt_f4"
                style="@style/NovaQuickKey"
                android:layout_columnWeight="1"
                android:text="@string/game_menu_send_keys_alt_f4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qk_f11"
                style="@style/NovaQuickKey"
                android:layout_columnWeight="1"
                android:text="@string/game_menu_send_keys_f11" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qk_super"
                style="@style/NovaQuickKey"
                android:layout_columnWeight="1"
                android:text="@string/nova_quick_menu_key_meta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qk_ctrl_v"
                style="@style/NovaQuickKey"
                android:layout_columnWeight="1"
                android:text="@string/game_menu_send_keys_ctrl_v" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/nova_command_panel_bg"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    style="@style/NovaQuickMenuCardTitle"
                    android:text="@string/nova_quick_menu_overlays" />

                <LinearLayout
                    android:id="@+id/toggle_hud"
                    style="@style/NovaQuickMenuCompactRow"
                    android:layout_width="match_parent">

                    <TextView
                        style="@style/NovaQuickMenuRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/nova_quick_menu_nova_hud" />

                    <TextView
                        android:id="@+id/hud_state"
                        style="@style/NovaQuickMenuState"
                        android:text="@string/nova_quick_menu_off" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggle_perf_stats"
                    style="@style/NovaQuickMenuCompactRow"
                    android:layout_width="match_parent">

                    <TextView
                        style="@style/NovaQuickMenuRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/nova_quick_menu_perf_stats" />

                    <TextView
                        android:id="@+id/perf_state"
                        style="@style/NovaQuickMenuState"
                        android:text="@string/nova_quick_menu_off" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/nova_command_panel_bg"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    style="@style/NovaQuickMenuCardTitle"
                    android:text="@string/nova_quick_menu_controls" />

                <LinearLayout
                    android:id="@+id/toggle_mouse_mode"
                    style="@style/NovaQuickMenuCompactRow"
                    android:layout_width="match_parent">

                    <TextView
                        style="@style/NovaQuickMenuRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/nova_quick_menu_mouse" />

                    <TextView
                        android:id="@+id/mouse_mode_label"
                        style="@style/NovaQuickMenuState"
                        android:text="@string/nova_quick_menu_direct" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggle_osc"
                    style="@style/NovaQuickMenuCompactRow"
                    android:layout_width="match_parent">

                    <TextView
                        style="@style/NovaQuickMenuRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/nova_quick_menu_controller" />

                    <TextView
                        android:id="@+id/osc_state"
                        style="@style/NovaQuickMenuState"
                        android:text="@string/nova_quick_menu_off" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggle_keyboard"
                    style="@style/NovaQuickMenuCompactRow"
                    android:layout_width="match_parent">

                    <TextView
                        style="@style/NovaQuickMenuRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/nova_quick_menu_keyboard" />

                    <TextView
                        android:id="@+id/keyboard_state"
                        style="@style/NovaQuickMenuState"
                        android:text="@string/nova_quick_menu_hidden" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/nova_command_panel_bg"
            android:orientation="vertical"
            android:padding="11dp">

            <TextView
                style="@style/NovaQuickMenuCardTitle"
                android:text="@string/nova_quick_menu_session" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/action_paste_clipboard"
                    style="@style/NovaQuickMenuTextAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/nova_quick_menu_paste_clipboard" />

                <TextView
                    android:id="@+id/action_rotate_screen"
                    style="@style/NovaQuickMenuTextAction"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/nova_quick_menu_rotate_screen" />

                <TextView
                    android:id="@+id/action_more_keys"
                    style="@style/NovaQuickMenuTextAction"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/nova_quick_menu_special_keys" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
