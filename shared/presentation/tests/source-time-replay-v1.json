{
  "schema": "nova-source-time-replay-v1",
  "policyVersion": 1,
  "units": "all clock values microseconds; RTP 90 kHz modulo 2^32",
  "anchorRule": "client monotonic reassembly enqueue where callback can block; callback ingress diagnostic only; ms quantization explicit",
  "stateDefinitions": {
    "pending": "valid raw timing, warmup incomplete",
    "source_time": "valid mapping after warmup",
    "unavailable": "no usable timing point; legacy fallback required"
  },
