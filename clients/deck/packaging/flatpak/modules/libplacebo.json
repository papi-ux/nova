{
  "name": "libplacebo",
  "buildsystem": "meson",
  "config-opts": [
    "--buildtype=release",
    "--wrap-mode=nofallback",
    "-Ddefault_library=shared",
    "-Dvulkan=enabled",
    "-Dshaderc=enabled",
    "-Dglslang=disabled",
    "-Dopengl=disabled",
    "-Dd3d11=disabled",
    "-Ddovi=disabled",
    "-Dlibdovi=disabled",
    "-Ddemos=false"
  ],
  "post-install": [
    "install -Dm644 /run/build/libplacebo/LICENSE /app/share/licenses/libplacebo/LICENSE"
