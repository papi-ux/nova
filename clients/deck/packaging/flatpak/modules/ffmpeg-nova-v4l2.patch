 } V4L2m2mPriv;
 
 /**
--- a/libavcodec/v4l2_m2m.c
+++ b/libavcodec/v4l2_m2m.c
@@ -212,6 +212,13 @@
 
     av_log(log_ctx, AV_LOG_DEBUG, "reinit context\n");
 
+    /* A retained GPU upload may still own a capture buffer. Refuse a
+     * resolution change rather than waiting for a UI/render-thread release.
+     * Nova reconnects with a fresh decoder instead. Ordinary FFmpeg behavior
+     * is unchanged unless the caller explicitly selects this option. */
+    if (((V4L2m2mPriv *)s->priv)->nova_nonblocking && atomic_load(&s->refcount))
+        return AVERROR(ENOSYS);
+
     /* 1. streamoff */
     ret = ff_v4l2_context_set_status(&s->capture, VIDIOC_STREAMOFF);
     if (ret)
@@ -295,6 +302,15 @@
 
     V4L2m2mContext *s = priv->context;
 
+    /* Nova's private ARM provider must use exactly the qualified device. */
+    if (priv->nova_device && priv->nova_device[0]) {
+        if (strlen(priv->nova_device) >= sizeof(s->devname))
+            return AVERROR(EINVAL);
+        strcpy(s->devname, priv->nova_device);
+        ret = v4l2_probe_driver(s);
+        return ret ? ret : v4l2_configure_contexts(s);
+    }
+
     dirp = opendir("/dev");
     if (!dirp)
         return AVERROR(errno);
